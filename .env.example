# ---------------------------------------------------------------------------
# 99Estate — environment template
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Only NEXT_PUBLIC_* variables are shipped to the browser.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -------------------------------------------------------------------
# Absolute origin, used for OAuth redirects, canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google OAuth -----------------------------------------------------------
# Configured in Supabase Dashboard → Authentication → Providers → Google.
# Authorised redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# Kept here so infra-as-code / local Supabase CLI can consume them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments (Phase 10 — not wired up yet) ---------------------------------
# Provider is selected at runtime so the gateway can be swapped per environment.
# Supported: razorpay | mock
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
