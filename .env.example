# ---------------------------------------------------------------------------
# 99Estate — environment template
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Only NEXT_PUBLIC_* variables are shipped to the browser.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. Must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -------------------------------------------------------------------
# Absolute origin, used for OAuth redirects, canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google OAuth -----------------------------------------------------------
# Configured in Supabase Dashboard → Authentication → Providers → Google.
# Authorised redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# Kept here so infra-as-code / local Supabase CLI can consume them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments ---------------------------------------------------------------
# Supported: razorpay | mock
#
#   mock      every order reports as paid. Lets you exercise the unlock →
#             payment → lead path with no gateway account. Refuses to load
#             when NODE_ENV=production, because it would make paid contacts
#             free.
#   razorpay  Checkout renders a UPI QR on desktop and hands off to
#             GPay/PhonePe/Paytm on mobile, plus cards, net banking, wallets.
PAYMENT_PROVIDER=mock

# Razorpay Dashboard → Account & Settings → API Keys.
# KEY is `key_id` (rzp_test_… / rzp_live_…) — public, it reaches the browser.
# SECRET is `key_secret` — server-only, never prefix it with NEXT_PUBLIC_.
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# Razorpay Dashboard → Settings → Webhooks.
#   URL     https://<your-domain>/api/webhooks/razorpay
#   Events  payment.captured, order.paid
# The secret you set there goes here; it is what signs the payload.
#
# Optional to start: the return-from-checkout path verifies server-side on its
# own and works on localhost with no public URL. Add the webhook before going
# live — without it, a buyer who pays and then closes the tab is charged with
# the contact still locked.
PAYMENT_WEBHOOK_SECRET=

# --- Scheduled listing maintenance ------------------------------------------
# Bearer token for /api/cron/listings, which expires listings past their 90-day
# window and warns sellers 7 days ahead (§18).
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# On Vercel: set this in Project Settings → Environment Variables and the
# scheduler in `vercel.json` sends it automatically as `Authorization: Bearer`.
# The schedule there is `30 18 * * *` — Vercel crons are UTC, and 18:30 UTC is
# 00:00 IST, the same moment the free-unlock quota resets.
#
# Anywhere else, call it from any scheduler:
#   curl -X POST https://<your-domain>/api/cron/listings \
#        -H "Authorization: Bearer $CRON_SECRET"
#
# Without this set the route returns 503 and the 90-day lifecycle never runs.
# Admins can always trigger the same sweep by hand from /admin.
CRON_SECRET=
