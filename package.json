{
  "name": "99estate",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run verify:video && npm run verify:routes",
    "verify:video": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-video-urls.mts",
    "verify:routes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-routes.mts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.types.ts",
    "db:verify": "supabase db reset && docker exec -i supabase_db_99estate psql -U postgres -d postgres -v ON_ERROR_STOP=1 -q < supabase/tests/business_rules.sql",
    "db:seed:remote": "node --env-file=.env.local scripts/seed-remote.mjs",
    "db:verify:remote": "node --env-file=.env.local scripts/verify-remote.mjs",
    "gen:logo": "node scripts/generate-logo.mjs",
    "db:purge-demo": "node --env-file=.env.local scripts/purge-demo.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.110.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.5.3",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
